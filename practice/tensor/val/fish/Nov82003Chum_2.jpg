ideo class="x-mejs has-stack-styles" poster="https://www.valleyfishing.com/wp-content/uploads/2019/02/Valley-Fishing-Guides-Fly-Fishing-BC.jpg" preload="metadata" autoplay loop muted playsinline><source src="/wp-content/uploads/2019/02/Valley-Fishing-Guides-Squamish-BC-Canada.mp4" type="video/mp4"></video></div></script></div></div></div><div class="e15-e17 x-bar-content"><div class="x-bar-container e15-e18 mf-6 mf-7 mf-b mf-c mf-d"><span class="x-image e15-e19 mf-26 mf-27"><img src="https://www.valleyfishing.com/wp-content/uploads/2019/02/Valley-Fishing-Guides-Whistler-British-Columbia.png" width="250" height="250" alt="Squamish, B.C. Fishing Guides" loading="lazy"></span><div class="x-text x-text-headline e15-e20 mf-29 mf-2a mf-2b mf-2c"><div class="x-text-content"><div class="x-text-content-text"><h2 class="x-text-content-text-primary">Valley Fishing Guides</h2></div></div></div><a class="x-anchor x-anchor-button e15-e21 mf-r mf-s mf-u mf-y mf-z mf-10 mf-12 mf-13 mf-14 mf-15 mf-1i mf-1k mf-1t mf-22" tabindex="0" href="/trips/"><div class="x-anchor-content"><div class="x-anchor-text"><span class="x-anchor-text-primary" data-x-single-anim="x-scale-up">View Fly Fishing Trips</span></div></div></a><div class="x-text x-text-headline e15-e22 mf-2a mf-2c mf-2d mf-2e mf-2f"><div class="x-text-content"><div class="x-text-content-text"><h3 class="x-text-content-text-primary">Celebrating OVer 25 Years OF Premier Fly Fishing TRIPS In Squamish British Columbia<br />Gift Certificates Available</h3></div></div></div></div></div></div><div class="x-bar x-bar-top x-bar-h x-bar-relative x-bar-outer-spacers x-hide-lg x-hide-md x-hide-xl e15-e23 mf-1 mf-3 mf-5" data-x-bar="{&quot;id&quot;:&quot;e15-e23&quot;,&quot;region&quot;:&quot;top&quot;,&quot;height&quot;:&quot;auto&quot;}"><div class="x-bg" aria-hidden="true"><div class="x-bg-layer-lower-image"></div><div class="x-bg-layer-upper-color"></div></div><div class="e15-e23 x-bar-content"><div class="x-bar-container e15-e24 mf-6 mf-7 mf-b mf-d mf-e"><span class="x-image e15-e25 mf-26 mf-28"><img src="https://www.valleyfishing.com/wp-content/uploads/2019/02/Valley-Fishing-Guides-Whistler-British-Columbia.png" width="250" height="250" alt="Image" loading="lazy"></span><div class="x-text x-text-headline e15-e26 mf-29 mf-2a mf-2b mf-2c mf-2f"><div class="x-text-content"><div class="x-text-content-text"><h2 class="x-text-content-text-primary">Valley Fishing Guides</h2></div></div></div><div class="x-text x-text-headline e15-e27 mf-29 mf-2a mf-2e mf-2f mf-2g"><div class="x-text-content"><div class="x-text-content-text"><h3 class="x-text-content-text-primary">Premier Fly Fishing Guides In British Columbia</h3></div></div></div></div></div></div></header><div class="x-main full" role="main"><article id="post-8" class="post-8 page type-page status-publish hentry no-post-thumbnail"><div class="entry-content content"><div id="cs-content" class="cs-content"><div class="x-section e8-e1 m8-0 m8-1 m8-2 m8-3"><div class="x-bg" aria-hidden="true"><div class="x-bg-layer-lower-image"></div><div class="x-bg-layer-upper-color"></div></div><div class="x-container max width e8-e2 m8-b m8-c constrain-row"><div class="x-column x-sm x-1-1 e8-e3 m8-f m8-g"><div class="x-text x-text-headline e8-e4 m8-v m8-w m8-x m8-y m8-z m8-10 m8-11"><div class="x-text-content"><div class="x-text-content-text"><h1 class="x-text-content-text-primary">Fly Fishing From Whistler, Squamish, Vancouver &amp; Pemberton, B.C.</h1></div></div></div><div class="x-text x-content e8-e5 m8-17 m8-18 m8-19 m8-1a m8-1b m8-1c m8-1d m8-1e m8-1f"><p>Welcome to Valley Fishing Guides located in Squamish, British Columbia. Squamish is just a 45 minute drive north of Vancouver and 45 minutes south of Whistler. For 25 years our fly fishing guides have specialized in remote wilderness fly fishing trips in Squamish and Whistler BC.</p><p>Come fish with the original Squamish local fly fishing guide service.</p></div></div></div></div><div class="x-section e8-e6 m8-0 m8-1 m8-4 m8-5"><div class="x-container max width marginless-columns e8-e7 m8-c m8-d"><div class="x-column x-sm x-1-4 e8-e8 m8-f m8-g m8-h m8-i m8-j home-trips"><div class="x-bg" aria-hidden="true"><div class="x-bg-layer-lower-image"></div><div class="x-bg-layer-upper-color"></div></div><a class="x-anchor x-anchor-button e8-e9 m8-1p m8-1q m8-1r m8-1s m8-1t m8-1u home-button" tabindex="0" href="/corporate-trips/"><div class="x-anchor-content"><div class="x-anchor-text"><span class="x-anchor-text-primary" data-x-single-anim="x-scale-up"><h2>Corporate Trips</h2></span></div></div></a></div><div class="x-column x-sm x-1-4 e8-e10 m8-f m8-g m8-i m8-k home-trips"><div class="x-bg" aria-hidden="true"><div class="x-bg-layer-lower-image"></div><div class="x-bg-layer-upper-color"></div></div><a class="x-anchor x-anchor-button e8-e11 m8-1p m8-1q m8-1r m8-1s m8-1t m8-1u home-button" tabindex="0" href="/day-trips/"><div class="x-anchor-content"><div class="x-anchor-text"><span class="x-anchor-text-primary" data-x-single-anim="x-scale-up"><h2>Day Trips</h2></span></div></div></a></div><div class="x-column x-sm x-1-4 e8-e12 m8-f m8-g m8-i m8-j m8-l home-trips"><div class="x-bg" aria-hidden="true"><div class="x-bg-layer-lower-image"></div><div class="x-bg-layer-upper-color"></div></div><a class="x-anchor x-anchor-button e8-e13 m8-1p m8-1q m8-1r m8-1s m8-1t m8-1u home-button" tabindex="0" href="/multi-day-trips/"><div class="x-anchor-content"><div class="x-anchor-text"><span class="x-anchor-text-primary" data-x-single-anim="x-scale-up"><h2>Multi-Day Trips</h2></span></div></div></a></div><div class="x-column x-sm x-1-4 e8-e14 m8-f m8-g m8-i m8-m home-trips"><div class="x-bg" aria-hidden="true"><div class="x-bg-layer-lower-image"></div><div class="x-bg-layer-upper-color"></div></div><a class="x-anchor x-anchor-button e8-e15 m8-1p m8-1q m8-1r m8-1s m8-1t m8-1u home-button" tabindex="0" href="/heli-fishing/"><div class="x-anchor-content"><div class="x-anchor-text"><span class="x-anchor-text-primary" data-x-single-anim="x-scale-up"><h2>Heli-Fishing</h2></span></div></div></a></div></div></div><div class="x-section e8-e16 m8-0 m8-6 m8-7 constrain-row"><div class="x-container max width marginless-columns e8-e17 m8-b m8-c"><div class="x-column x-sm x-1-2 e8-e18 m8-f m8-g"><span class="x-image e8-e19 m8-22 m8-23"><img decoding="async" src="https://www.valleyfishing.com/wp-content/uploads/2019/02/squamish_valley_fshing.jpg" width="800" height="1028" alt="Guided fly fishing trips near Vancouver, B.C." loading="lazy"></span></div><div class="x-column x-sm x-1-2 e8-e20 m8-f m8-n m8-o m8-p"><hr class="x-line e8-e21 m8-26 m8-27"/><div class="x-text x-text-headline e8-e22 m8-v m8-w m8-z m8-12 m8-13 m8-14"><div class="x-text-content"><div class="x-text-content-text"><h3 class="x-text-content-text-primary">What to expect from <nobr>Valley Fishing Guides</nobr></h3> <span class="x-text-content-text-subheadline">Fly Fishing</span></div></div></div><div class="x-text x-content e8-e23 m8-19 m8-1b m8-1c m8-1d m8-1g m8-1h overlay-text"><p>At Valley Fishing Guides, we pride ourselves on having the <a href="/about-us/">knowledge and experience</a> to provide you with a very memorable fly fishing trip into the remote wilderness of beautiful British Columbia, Canada.</p></div><div class="x-text x-content e8-e24 m8-19 m8-1a m8-1c m8-1e m8-1g m8-1i m8-1j m8-1k"><p><i class="home-icons x-icon x-graphic-primary" aria-hidden="true" data-x-icon-l=""></i> <span class="home-bullets">Stunning Scenery </span><br /><i class="home-icons x-icon x-graphic-primary" aria-hidden="true" data-x-icon-l=""></i> <span class="home-bullets"> Fly Fishing Education</span><br /><i class="home-icons x-icon x-graphic-primary" aria-hidden="true" data-x-icon-l=""></i>&nbsp;25 YEARS GUIDING <span class="home-bullets">Experience</span><br /><i class="home-icons x-icon x-graphic-primary" aria-hidden="true" data-x-icon-l=""></i> <span class="home-bullets"> Unique Trip Options</span></p></div></div></div></div><div class="x-section e8-e25 m8-0 m8-1 m8-8"><div class="x-bg" aria-hidden="true"><div class="x-bg-layer-upper-color"></div></div><div class="x-container max width e8-e26 m8-b m8-c constrain-row"><div class="x-column x-sm x-1-1 e8-e27 m8-f m8-n m8-q m8-r"><div class="x-text x-text-headline e8-e28 m8-w m8-x m8-y m8-z m8-13 m8-14 m8-15"><div class="x-text-content"><div class="x-text-content-text"><h3 class="x-text-content-text-primary">We Fish Year-Round!</h3></div></div></div><div class="x-text x-content e8-e29 m8-17 m8-18 m8-19 m8-1a m8-1b m8-1c m8-1d m8-1e m8-1l"><p>The Vancouver, <a href="/squamish-fly-fishing/">Squamish</a>, <a href="/whistler-fly-fishing-trips/">Whistler</a> and Pemberton areas are home to several species of salmonids including rainbow trout, <a title="bull trout" href="https://www.valleyfishing.com/galleries/squamish-bull-trout-fly-fishing-photos/">bull trout</a>, cutthroat trout, <a title="squamish steelhead" href="https://www.valleyfishing.com/galleries/squamish-steelhead/">steelhead</a> and five species of <a title="salmon fly fishing" href="https://www.valleyfishing.com/galleries/salmon-fishing/">salmon</a>. Whether you are a beginner or a seasoned angler, our guides are dedicated to providing the best <a title="fly fishing photos" href="https://www.valleyfishing.com/galleries/valley-fishing-guides/">fly fishing</a> experience on the West Coast of Canada. Depending on the season, we can offer you stillwater fly fishing, river fly fishing or saltwater fly fishing. Our <a title="our guides" href="/our-guides/">professionally trained fly fishing guides</a> will get you to the best fly fishing water available.</p></div></div></div></div><div class="x-section e8-e30 m8-0 m8-1 m8-4 m8-7"><div class="x-container max width marginless-columns e8-e31 m8-c m8-d m8-e constrain-row"><div class="x-column x-sm x-1-2 e8-e32 m8-f m8-s"><div class="x-text x-text-headline e8-e33 m8-v m8-w m8-y m8-11 m8-13 m8-16"><div class="x-text-content"><div class="x-text-content-text"><h4 class="x-text-content-text-primary">Preferred Suppliers</h4></div></div></div><div class="x-text x-content e8-e34 m8-18 m8-19 m8-1a m8-1b m8-1c m8-1d m8-1m m8-1n">We use the best equipment to ensure you have a great experience!  We provide waders and boots by Simms and fly rods and reels by Sage.</div></div><div class="x-column x-sm x-1-2 e8-e35 m8-f m8-q m8-r m8-t"><span class="x-image e8-e36 m8-22 m8-24 m8-25"><img decoding="async" src="https://www.valleyfishing.com/wp-content/uploads/2019/02/Simms-Fishing-1.png" width="310" height="150" alt="Simms Fly Fishing" loading="lazy"></span><span class="x-image e8-e37 m8-22 m8-24 m8-25"><img decoding="async" src="https://www.valleyfishing.com/wp-content/uploads/2019/02/Fishpond-Fishing.png" width="310" height="150" alt="Fishpond Fishing" loading="lazy"></span><span class="x-image e8-e38 m8-22 m8-24 m8-25"><img decoding="async" src="https://www.valleyfishing.com/wp-content/uploads/2019/02/Redington-Fishing-1.png" width="310" height="150" alt="Redington Fishing Gear" loading="lazy"></span><span class="x-image e8-e39 m8-22 m8-24 m8-25"><img decoding="async" src="https://www.valleyfishing.com/wp-content/uploads/2019/02/Patagonia-Fishing-1.png" width="310" height="150" alt="Patagonia Fishing Gear" loading="lazy"></span><span class="x-image e8-e40 m8-22 m8-24 m8-25"><img decoding="async" src="https://www.valleyfishing.com/wp-content/uploads/2019/07/Hanak.png" width="310" height="150" alt="Hanak Competition" loading="lazy"></span><span class="x-image e8-e41 m8-22 m8-24 m8-25"><img decoding="async" src="https://www.valleyfishing.com/wp-content/uploads/2019/02/Sage-Fishing-1.png" width="310" height="150" alt="Sage Fishing" loading="lazy"></span></div></div><div class="x-container max width e8-e42 m8-b m8-c"><div class="x-column x-sm x-1-1 x-hide-sm x-hide-xs e8-e43 m8-f m8-g"><div id="envira-gallery-wrap-558" class="envira-gallery-wrap envira-lazy-loading-disabled envira-layout-mason envira-gallery-th