est":{"id":"a668de2e-f9ca-43f0-861b-dabdef490b94","cmsType":"PromoListModule","edgs":[{"id":"136a6dfd-7536-4f2a-98f5-f2037f285b46","cmsType":"RegularStandardPrismTile","isPremium":false,"isEntitled":false,"isFreemium":true,"isUserAuthed":false,"pageType":"home","storyId":"drn:src:natgeo:unison::prod:67e3e4fd-c4da-4e67-9b6b-1adeed8502f8","cId":"136a6dfd-7536-4f2a-98f5-f2037f285b46_67e3e4fd-c4da-4e67-9b6b-1adeed8502f8","ctas":[{"url":"https://www.nationalgeographic.com/science/article/how-to-see-saturn-rings"}],"img":{"crps":[{"nm":"raw","aspRto":1.0059288537549407,"url":"https://i.natgeofe.com/n/ed3978c0-de38-4d6e-b6a5-df86451576ad/PIA08358orig.jpg"},{"nm":"16x9","aspRto":1.7777777777777777,"url":"https://i.natgeofe.com/n/ed3978c0-de38-4d6e-b6a5-df86451576ad/PIA08358orig_16x9.jpg"},{"nm":"3x2","aspRto":1.5,"url":"https://i.natgeofe.com/n/ed3978c0-de38-4d6e-b6a5-df86451576ad/PIA08358orig_3x2.jpg"},{"nm":"square","aspRto":1,"url":"https://i.natgeofe.com/n/ed3978c0-de38-4d6e-b6a5-df86451576ad/PIA08358orig_square.jpg"},{"nm":"2x3","aspRto":0.6666666666666666,"url":"https://i.natgeofe.com/n/ed3978c0-de38-4d6e-b6a5-df86451576ad/PIA08358orig_2x3.jpg"},{"nm":"3x4","aspRto":0.75,"url":"https://i.natgeofe.com/n/ed3978c0-de38-4d6e-b6a5-df86451576ad/PIA08358orig_3x4.jpg"},{"nm":"4x3","aspRto":1.3333333333333333,"url":"https://i.natgeofe.com/n/ed3978c0-de38-4d6e-b6a5-df86451576ad/PIA08358orig_4x3.jpg"},{"nm":"2x1","aspRto":2,"url":"https://i.natgeofe.com/n/ed3978c0-de38-4d6e-b6a5-df86451576ad/PIA08358orig_2x1.jpg"}],"rt":"https://i.natgeofe.com/n/ed3978c0-de38-4d6e-b6a5-df86451576ad/PIA08358orig.jpg","src":"https://i.natgeofe.com/n/ed3978c0-de38-4d6e-b6a5-df86451576ad/PIA08358orig.jpg","dsc":"Magnificent blue and gold Saturn floats obliquely as one of its gravity-bound companions, Dione, hangs in the distance. The darkened rings seem to nearly touch their shadowy reverse images on the planet below. This view looks toward the unlit side of the rings from about 9 degrees above the ring plane. The rings glow feebly in the scattered light that filters through them. Dione is 1,126 kilometers (700 miles) across. The image was taken in visible light with the Cassini spacecraft wide-angle camera on Feb. 4, 2007, at a distance of approximately 1.2 million kilometers (800,000 miles) from Saturn. Image scale is 75 kilometers (47 miles) per pixel. The Cassini-Huygens mission is a cooperative project of NASA, the European Space Agency and the Italian Space Agency. The Jet Propulsion Laboratory, a division of the California Institute of Technology in Pasadena, manages the mission for NASA's Science Mission Directorate, Washington, D.C. The Cassini orbiter and its two onboard cameras were designed, developed and assembled at JPL. The imaging operations center is based at the Space Science Institute in Boulder, Colo. For more information about the Cassini-Huygens mission visit http://saturn.jpl.nasa.gov/home/index.cfm. The Cassini imaging team homepage is at http://ciclops.org."},"title":"Get a Glimpse of Saturn's Rings This Week","abTest":{"testId":"nat_geo_landing_page_tests-479","variantId":"variant_a_control-1956","type":"textHighlightTest","variant":"variant_a","abTest":"nat_geo_landing_page_tests-479*variant_a_control-1956"}},{"id":"136a6dfd-7536-4f2a-98f5-f2037f285b46","cmsType":"RegularStandardPrismTile","isPremium":false,"isEntitled":false,"isFreemium":true,"isUserAuthed":false,"pageType":"home","storyId":"drn:src:natgeo:unison::prod:998a20d7-c858-409c-a946-9c8ee1330d02","cId":"136a6dfd-7536-4f2a-98f5-f2037f285b46_998a20d7-c858-409c-a946-9c8ee1330d02","ctas":[{"url":"https://www.nationalgeographic.com/environment/article/el-nino-climate-change-hurricanes-atlantic-pacific"}],"img":{"crps":[{"nm":"raw","aspRto":1.4733812949640288,"url":"https://i.natgeofe.com/n/bf93cde3-bb9e-4e7d-936d-5f4f69af465c/GettyImages-2297601492.jpg"},{"nm":"16x9","aspRto":1.7777777777777777,"url":"https://i.natgeofe.com/n/bf93cde3-bb9e-4e7d-936d-5f4f69af465c/GettyImages-2297601492_16x9.jpg"},{"nm":"3x2","aspRto":1.5,"url":"https://i.natgeofe.com/n/bf93cde3-bb9e-4e7d-936d-5f4f69af465c/GettyImages-2297601492_3x2.jpg"},{"nm":"square","aspRto":1,"url":"https://i.natgeofe.com/n/bf93cde3-bb9e-4e7d-936d-5f4f69af465c/GettyImages-2297601492_square.jpg"},{"nm":"2x3","aspRto":0.6666666666666666,"url":"https://i.natgeofe.com/n/bf93cde3-bb9e-4e7d-936d-5f4f69af465c/GettyImages-2297601492_2x3.jpg"},{"nm":"3x4","aspRto":0.75,"url":"https://i.natgeofe.com/n/bf93cde3-bb9e-4e7d-936d-5f4f69af465c/GettyImages-2297601492_3x4.jpg"},{"nm":"4x3","aspRto":1.3333333333333333,"url":"https://i.natgeofe.com/n/bf93cde3-bb9e-4e7d-936d-5f4f69af465c/GettyImages-2297601492_4x3.jpg"},{"nm":"2x1","aspRto":2,"url":"https://i.natgeofe.com/n/bf93cde3-bb9e-4e7d-936d-5f4f69af465c/GettyImages-2297601492_2x1.jpg"}],"rt":"https://i.natgeofe.com/n/bf93cde3-bb9e-4e7d-936d-5f4f69af465c/GettyImages-2297601492.jpg","src":"https://i.natgeofe.com/n/bf93cde3-bb9e-4e7d-936d-5f4f69af465c/GettyImages-2297601492.jpg","dsc":"LONG BEACH, CALIFORNIA - SEPTEMBER 28: A person watches on a closed section of boardwalk as a Pacific Ocean wave crashes into a seawall protecting beachfront homes on September 28, 2026 in Long Beach, California. Heavy surf generated by Hurricane Polo offshore, amid a Pacific Ocean heatwave and an emerging El Niño, led to a coastal flood advisory from the National Weather Service for much of Southern California."},"title":"Why Are All the Hurricanes Forming Out West This Year?","abTest":{"testId":"nat_geo_landing_page_tests-479","variantId":"variant_a_control-1956","type":"textHighlightTest","variant":"variant_a","abTest":"nat_geo_landing_page_tests-479*variant_a_control-1956"}},{"id":"136a6dfd-7536-4f2a-98f5-f2037f285b46","cmsType":"RegularStandardPrismTile","isPremium":false,"isEntitled":false,"isFreemium":true,"isUserAuthed":false,"pageType":"home","storyId":"drn:src:natgeo:unison::prod:748831a8-17dd-4227-8127-080e4c3d0332","cId":"136a6dfd-7536-4f2a-98f5-f2037f285b46_