dark TintOverlay--tint"></div></div></div><div class="GeneralContainer GeneralContainer--fullWidth"><div id="75c4181b-da40-40ec-adc7-edc48f2a1afb" class="StackModule"><div class="BgImagePromo"><div class="BgImagePromo__Container"><div class="BackgroundImage BgImagePromo__Container__BgImage"><div class="RatioFrame aspect-ratio--auto"></div><span class="BackgroundImage__Image BackgroundImage__Image--lowRes" style="background-position:center center;transition:transform .25s ease, opacity .5s ease;background-image:url(&quot;data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=&quot;)"></span><span class="BackgroundImage__Image BackgroundImage__Image--highRes"></span></div><div class="BgImagePromo__Container__Content"><div class="BgImagePromo__Container__InnerContent BgImagePromo__Container--nologo"><div class="BgImagePromo__Container__Text"><a class="AnchorLink AnchorLink--dark BgImagePromo__Container__Text__Link" tabindex="0" aria-labelledby="ariaLabel-f966a3d9-31f6-448a-bf69-cc9856816d29" aria-describedby="ariaDescription-f966a3d9-31f6-448a-bf69-cc9856816d29" target="_blank" href="https://www.nationalgeographic.com/photo-of-the-day"><span class="sr-only">A Moment in Flight</span></a><ul class="SectionLabelWrapper BgImagePromo__Container__TextKicker SectionLabelWrapper--dark"><li class="SectionLabel SectionLabel--custom"><span><span>PHOTO OF THE DAY</span></span></li></ul><h2 id="ariaLabel-f966a3d9-31f6-448a-bf69-cc9856816d29" class="BgImagePromo__Container__TextTitle">A Moment in Flight</h2><span id="ariaDescription-f966a3d9-31f6-448a-bf69-cc9856816d29" class="BgImagePromo__Container__TextAbstract">A short-eared owl (Asio flammeus) flies over the salt marshes of British Columbia’s Fraser River Delta at dusk. These owls fly low and slow as they hunt, relying primarily on acute hearing to drop down on prey hidden under grass coves.</span><div data-track-event_name="cta button click" data-track-button_type="See