    /* Responsive tweaks for small screens */
    @media (max-width: 576px) {
      .feed_user_date { max-width: none; width: auto; display: block; }
      .table img { float: none !important; margin: 0.25rem auto; display: block; }
      .clock-container { width: 140px; height: 140px; font-size: 20px; }
      nav .container-fluid { padding-left: 0.5rem; padding-right: 0.5rem; }
      /* keep table header fixed and aligned on small phones */
      #feedTable thead th:first-child { width: 30% !important; }
      #feedTable thead th:nth-child(2) { width: 70% !important; }
    }

    /* Ensure feed table uses the full available width on large screens */
    #feedTable, table.dataTable {
      width: 100% !important;
    }
    .dataTables_wrapper {
      width: 100% !important;
    }

    /* Make table cells align to top so User/Date matches Notification height */
    /* Reduced padding to show more rows on small screens */
    #feedTable th, #feedTable td { vertical-align: top !important; padding: .35rem !important; }
    .feed_user_date { padding: .35rem !important; }

    /* Shade the entire row (both User/Date and Notification) for feed entries */
    #feedTable tbody tr { background-color: #efefef; }
    /* Ensure td backgrounds are transparent so tr shading shows through */
    #feedTable tbody tr td { background-color: transparent; }
    /* Keep header background white */
    #feedTable thead th { background-color: #fff !important; }
    /* Remove table gaps so shading appears continuous */
    #feedTable { border-collapse: collapse; border-spacing: 0; }
    /* Remove cell backgrounds that may create visible strips */
    #feedTable td, #feedTable th { background-clip: padding-box; }
    /* Make cell-inner use flex layout (avoid absolute positioning which caused overlaps) */
    #feedTable tbody td { position: static; }
    #feedTable tbody td .cell-inner { position: relative; display: flex; flex-direction: column; justify-content: flex-start; padding: .35rem; box-sizing: border-box; height: auto; }
    /* Ensure the two-column notif-inner keeps image and text aligned without overflowing */
    .notif-image { flex: 0 0 240px; max-width: 240px; overflow: hidden; }
    .notif-image a { display: block; }
    .notif-image img { display:block; max-width:100%; height:auto; float:none !important; object-fit: contain; }
    @media (max-width: 576px) {
      .notif-image { flex: 0 0 140px; max-width: 140px; }
    }

    /* --- Make each table row behave as a flex container for pixel-perfect equal heights --- */
    /* Keep header as a table so DataTables header styles continue to work */
    #feedTable thead, #feedTable tfoot { display: table; width: 100%; table-layout: fixed; }
    /* Make tbody a block so rows can be flex containers */
    #feedTable tbody { display: block; width: 100%; overflow-x: hidden; }
    /* Each row becomes a flex container with two columns */
    #feedTable tbody tr { display: flex; width: 100%; box-sizing: border-box; border-bottom: 1px solid #d0d0d0; overflow: hidden; }
    /* Make cells behave as flex items */
    #feedTable tbody tr td { display: block; flex: 0 0 auto; border: none; overflow: hidden; }
    /* Left column default: percentage-based but constrained via min/max; body flex set below for responsivity */
    #feedTable tbody tr td:first-child { /* placeholder, real values set later */ }
    /* Right column takes remaining space */
    #feedTable tbody tr td:nth-child(2) { flex: 1 1 auto; min-width: 0; }
    /* Ensure the row background spans both 'columns' */
    #feedTable tbody tr { background-color: #efefef; }
    #feedTable tbody tr td { background: transparent; }
    /* Keep header styling separate */
    #feedTable thead th { display: table-cell; }

    /* Ensure header column widths and padding match the body columns so borders align */
    /* Make header widths flexible but constrained to match body min/max */
    #feedTable thead th:first-child { width: 25%; max-width: 260px; min-width: 140px; box-sizing: border-box; }
    #feedTable thead th:nth-child(2) { width: 75%; box-sizing: border-box; }
    #feedTable thead th { padding: .75rem !important; border-bottom: 1px solid #d0d0d0; background-color: #fff !important; }

    /* Keep two-column layout even on small screens (disable automatic stacking) */
    /* Rows remain side-by-side; table container may scroll horizontally on very narrow viewports */
    #feedTable tbody tr { flex-direction: row; }
    /* Allow left column to grow/shrink within min/max while right column flexes */
    /* Default proportional layout: allow both columns to grow/shrink proportionally
       Use flex: 0 1 25% so left column can shrink if needed; right column flexes to fill remaining space */
    #feedTable tbody tr td:first-child { flex: 0 1 25%; min-width: 120px; max-width: 260px; overflow: hidden; }
    #feedTable tbody tr td:nth-child(2) { flex: 1 1 75%; min-width: 0; max-width: 100%; overflow: hidden; }
    /* Ensure notification images don't overflow their cell when floated */
    #feedTable td .cell-inner img { max-width: 100%; height: auto; display: block; }
    #feedTable td .cell-inner { overflow: hidden; width: 100%; }

    /* Notification inner layout: by default flex row, but stacked makes it vertical */
    .notif-inner { display: flex; gap: .5rem; align-items: flex-start; }
    /* Stacked layout: title, image, description vertically */
    .notif-inner.notif-stacked { flex-direction: column; }
    /* Title styling */
    .notif-title { font-weight: 500; margin-bottom: .25rem; word-wrap: break-word; overflow-wrap: break-word; word-break: normal; }
    /* Make image respect the available column space. On narrow screens the image will scale to its column width
       so it cannot overflow or push into the Notification area. On wider screens we cap the image width. */
    .notif-image { flex: 0 0 auto; max-width: 100%; margin-right: .25rem; }
    /* Desktop / tablet: limit the image column to a comfortable visual size */
    @media (min-width: 576px) {
      .notif-image { flex: 0 0 300px; max-width: 300px; }
      /* For stacked layout, let image use full width */
      .notif-stacked .notif-image { flex: none; max-width: 100%; margin-right: 0; }
    }
    /* Make the image always scale to the container width (no cropping) */
    .notif-image img { display: block; width: 100%; height: auto; max-height: 500px; border-radius: 8px; object-fit: contain; }
    /* Small notification thumbnail inside notification text if inserted elsewhere */
    img.notif-thumb { max-width: 100%; height: auto; display: block; }
    .notif-text { flex: 1 1 auto; word-wrap: break-word; overflow-wrap: break-word; word-break: normal; max-width: 100%; overflow: hidden; }
    /* Force long URLs and links to wrap/break properly */
    .notif-text a { 
      word-break: break-all !important; 
      overflow-wrap: break-word !important; 
      word-wrap: break-word !important;
      hyphens: auto;
      max-width: 100%;
      display: inline;
    }
    @media (max-width: 576px) {
      .notif-inner { flex-direction: column; }
      .notif-image { flex: 0 0 auto; max-width: 100%; margin-right: 0; }
      .notif-image img { max-height: 300px; }
    }

    /* Reduce extra spacing after the notification description and image */
    .notif-text p { margin: 0 0 .25rem 0; }
    .notif-text { margin-bottom: .25rem; }
    .cell-inner.notif-cell { padding-bottom: .25rem; }

    /* Center the digital clock and reduce spacing below it */
    #digital-clock { display: block; text-align: center; margin: .15rem 0 0 0; }
    /* header man image small spacing */
    #header-man { margin-top: 6px; margin-bottom: 6px; }
    .header-flex { display: inline-flex; gap: .75rem; align-items: center; justify-content: center; }

    /* Align navbar items vertically with logo */
    .navbar .container-fluid {
      align-items: center;
      display: flex;
    }
    .navbar-collapse {
      align-items: center;
    }
    .navbar-nav {
      margin-bottom: 0 !important;
      align-items: center;
    }
    .navbar form.d-flex {
      margin-bottom: 0;
      align-items: center;
    }

    /* Remove default Bootstrap navbar padding that pushes buttons down */
    @media (min-width: 992px) {
      .navbar-expand-lg .navbar-collapse {
        align-items: center;
        display: flex !important;
      }
      .navbar-expand-lg .navbar-nav {
        align-items: center;
      }
      .navbar .navbar-brand {
        margin-bottom: 0;
        padding-top: 0.3125rem;
        padding-bottom: 0.3125rem;
      }
    }

    /* Navigation login buttons stacking on mobile */
    @media (max-width: 991px) {
      /* When navbar is collapsed, stack the login buttons vertically and center them */
      .navbar-collapse {
        text-align: center;
      }
      .navbar-collapse .navbar-nav {
        align-items: center;
      }
      .navbar-collapse form.d-flex {
        flex-direction: column !important;
        align-items: center !important;
        justify-content: center !important;
        width: 100%;
        margin-top: 1rem;
      }
      .navbar-collapse form.d-flex .btn {
        margin-bottom: 0.5rem !important;
        margin-right: 0 !important;
        width: auto !important;
        min-width: 150px;
        max-width: 200px;
      }
      /* Position hamburger on the right on mobile */
      .navbar .container-fluid {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
      }
      .navbar-toggler {
        margin-left: auto;
        order: 2;
      }
      .navbar-brand {
        order: 1;
      }
      .navbar-collapse {
        order: 3;
        flex-basis: 100%;
        width: 100%;
      }
    }

    @media (max-width: 576px) {
      /* Keep man and quote inline on small screens but reduce sizes to fit */
      .header-flex { gap: .5rem; }
      .header-flex img { max-width: 64px !important; }
      #header-quote { font-size: 95%; }
    }

    /* Controls layout: Show section on left, Search section on right, both with labels above */
    .dataTables_wrapper { display: block; width: 100%; font-size: 0.85rem; }
    /* Show section on the left - inline block */
    .dataTables_wrapper .dataTables_length { 
      margin: 0 0.5rem 0.5rem 0; 
      display: inline-block;
      vertical-align: top;
    }
    /* Search section on the right - inline block */
    .dataTables_wrapper .dataTables_filter { 
      margin: 0 0 0.5rem 0; 
      display: inline-block;
      vertical-align: top;
    }
    /* Make labels stack vertically (text above control) within each section */
    .dataTables_wrapper .dataTables_length label {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.2rem;
      font-size: 0.85rem;
      margin: 0;
      width: auto !important;
      line-height: 1.5;
    }
    .dataTables_wrapper .dataTables_filter label {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-end;
      gap: 0.2rem;
      font-size: 0.85rem;
      margin: 0;
      width: auto !important;
      min-height: 48px;
    }
    /* Much smaller search input to fit side-by-side */
    .dataTables_wrapper .dataTables_filter input { 
      width: 200px !important; 
      max-width: 100%; 
      padding: 3px 6px; 
      box-sizing: border-box; 
      font-size: 0.85rem;
      height: 28px;
    }
    /* Smaller dropdown select */
    .dataTables_wrapper .dataTables_length select {
      font-size: 0.85rem;
      padding: 3px 6px;
      height: 28px;
    }
    /* Center the pagination and info text below the table */
    .dataTables_wrapper .dataTables_paginate,
    .dataTables_wrapper .dataTables_info { 
      display: block; 
      text-align: center; 
      width: 100%; 
      margin-top: .5rem; 
    }

    /* Large-screen: use fixed table layout so colgroup widths apply and shading fills full width */
    @media (min-width: 992px) {
      #feedTable { table-layout: fixed; }
      /* large-screen: make User/Date a fixed smaller width so Notification column is wider */
      #feedTable col:first-child { width: 180px; }
      /* ensure the entire row is shaded (both columns) */
      #feedTable tbody tr td { background-color: #efefef; }
      /* align large images to the left inside Notification column */
      #feedTable td:nth-child(2) img { float: left; margin-right: 1rem; display: inline-block; }
      /* remove extra right padding on table cells to let shading reach the edge */
      #feedTable td, #feedTable th { padding-right: 1rem !important; }
    }

    /* Small screens: make notification column wider than the user/date column */
    @media (max-width: 576px) {
      /* keep left column at fixed 180px on small screens so notification area remains larger */
      #feedTable col:first-child { width: 180px; }
      #feedTable col:nth-child(2) { width: calc(100% - 180px); }
      /* Keep controls inline but make them ultra-compact to fit side-by-side */
      .dataTables_wrapper { 
        font-size: 0.75rem !important;
        padding: 0 !important;
      }
      .dataTables_wrapper .dataTables_length { 
        display: inline-block !important; 
        float: left !important;
        margin: 0 0.3rem 0.4rem 0 !important;
      }
      .dataTables_wrapper .dataTables_filter { 
        display: inline-block !important; 
        float: right !important;
        margin: 0 0 0.4rem 0 !important;
      }
      /* Keep labels above controls, just make them smaller */
      .dataTables_wrapper .dataTables_length label,
      .dataTables_wrapper .dataTables_filter label {
        font-size: 0.75rem !important;
        gap: 0.15rem !important;
        min-height: auto !important;
      }
      .dataTables_wrapper .dataTables_length select {
        font-size: 0.75rem !important;
        padding: 2px 4px !important;
        min-width: 45px !important;
        height: 24px !important;
      }
      .dataTables_wrapper .dataTables_filter input { 
        width: 80px !important;
        font-size: 0.75rem !important;
        padding: 2px 4px !important;
        height: 24px !important;
      }
      /* reduce padding on small screens to tighten layout */
      #feedTable thead th { padding: .45rem !important; }
      /* On small screens place man and quote tighter: image left, text right */
      #header-man { max-width: 84px; }
      #header-quote { display: block; }
      #header-row { margin-bottom: .25rem; }
      /* compact DataTables labels */
      .dataTables_wrapper label { margin: 0 !important; }
    }

    /* Compact DataTables labels and controls globally */
    .dataTables_wrapper label { margin-right: .5rem; }
    .dataTables_wrapper .dataTables_length select { height: 28px; }

    /* Feed date/time responsive: show time under date on small screens */
    .feed-date .date-part { display: inline; }
    .feed-date .time-part { display: inline; color: inherit; }
    @media (max-width: 576px) {
      .feed-date .time-part { display: block; margin-top: .2rem; }
      .user-name { font-weight: 700; }
    }

    /* Controls ordering with flex; keep length left and search right on wide screens */
    .dataTables_wrapper .dataTables_length { order: 0; }
    .dataTables_wrapper .dataTables_filter { order: 1; margin-left: auto; }
    .dataTables_wrapper .dataTables_filter input { width: 150px !important; max-width: 100%; box-sizing: border-box; }

    /* Limit image width on large screens so they don't dominate the layout */
    @media (min-width: 992px) {
      #feedTable img.img-fluid { max-width: 240px !important; height: auto !important; }
      /* Limit large images that appear inside the Notification column so they don't dominate the page */
      #feedTable td:nth-child(2) img {
        max-width: 640px; /* absolute cap */
        max-width: 60%; /* relative cap within container */
        max-height: 480px;
        width: auto !important;
        height: auto !important;
        display: block;
        margin: .5rem 0; /* default vertical spacing; on large screens we float left */
        object-fit: contain;
      }
    }
